# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Runtime / local databases (regenerated via Alembic migrations, never committed)
*.db
*.sqlite
*.sqlite3

# Node / tooling caches
node_modules/

# Browser automation profiles (accidentally produced by local `flutter run -d chrome` sessions)
.chrome_fresh_profile/
*_fresh_profile/

# OS / editor cruft
.DS_Store
Thumbs.db

# Flutter/Dart (see mobile/.gitignore for the authoritative, tool-generated version)
**/build/
.dart_tool/

# --- Added 2026-08-15 ---
# These were committed before the rules above existed, so ignoring them was not
# enough: they stayed tracked until explicitly untracked with `git rm --cached`.
.pytest_cache/
mobile/.chrome_fresh_profile/
mobile/build/
mobile/.dart_tool/
# Local agent worktrees
.claude/worktrees/

# JetBrains IDE
.idea/
*.iml
