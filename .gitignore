# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Runtime / local databases (regenerated via Alembic migrations, never committed)
*.db
*.sqlite
*.sqlite3

# Node / tooling caches
node_modules/

# Browser automation profiles (accidentally produced by local `flutter run -d chrome` sessions)
.chrome_fresh_profile/
*_fresh_profile/

# OS / editor cruft
.DS_Store
Thumbs.db

# Flutter/Dart (see mobile/.gitignore for the authoritative, tool-generated version)
**/build/
.dart_tool/

# --- Added 2026-08-15 ---
# These were committed before the rules above existed, so ignoring them was not
# enough: they stayed tracked until explicitly untracked with `git rm --cached`.
.pytest_cache/
mobile/.chrome_fresh_profile/
mobile/build/
mobile/.dart_tool/
# Local agent worktrees
.claude/worktrees/

# JetBrains IDE
.idea/
*.iml

# Emergency evidence recordings. Encrypted at rest, but they are recordings
# of people in danger and must never enter version control regardless.
evidence_store/
*.enc

# Service account private keys. A Firebase adminsdk JSON is a full
# server-side credential for the project -- it was committed once, by a
# `git add -A` that swept up a file dropped in the repo root.
secrets/
*firebase-adminsdk*.json
*service-account*.json
*serviceaccount*.json

# Coverage output (SRS §10.1 measurement; regenerate with pytest --cov)
.coverage
htmlcov/

# Android release signing. A committed keystore is a leaked signing identity:
# whoever holds it can publish updates that every installed copy of SafeHer
# accepts as genuine.
**/key.properties
*.jks
*.keystore

# JVM crash dumps from Gradle/Android builds. Four of these were sitting in
# mobile/android/ untracked; they are pure build wreckage and never wanted.
hs_err_pid*.log
replay_pid*.log

# Captured `flutter run` output. mobile/flutter_err.txt and flutter_out.txt
# were committed by accident and have now been removed -- this keeps the next
# redirect from following them in.
mobile/flutter_*.txt

# Playwright MCP scratch output (browser logs/screenshots from local QA runs)
.playwright-mcp/

# Firmware credentials. `secrets.h.example` is committed; `secrets.h` is not.
glasses/**/secrets.h
glove/**/secrets.h
