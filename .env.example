# Core API
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=True
LOG_LEVEL=INFO

# Database / Supabase
POSTGRES_USER=safeher
POSTGRES_PASSWORD=safeher
POSTGRES_DB=safeher
DATABASE_URL=postgresql://safeher:safeher@localhost:5432/safeher
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# JWT / Auth
JWT_SECRET_KEY=change-me
JWT_ISSUER=safeher
JWT_AUDIENCE=safeher-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Notifications
FCM_SERVER_KEY=
# SMS. Costs money with every provider -- OneSignal is not an alternative
# here: its free-tier SMS works by connecting your own Twilio account, and
# its paid SMS is billed per message. Leave blank and SMS is reported as
# unconfigured rather than silently skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email, via OneSignal. Free tier covers 10,000 sends/month, but it needs a
# sending DOMAIN YOU OWN with SPF/DKIM/DMARC records -- Gmail and Outlook
# addresses are explicitly refused as senders. Use this once you have a
# domain; until then use the SMTP block above, which needs neither.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Storage (Cloudinary or Firebase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# If using Firebase Storage instead, set: FIREBASE_STORAGE_BUCKET=

# OpenAI (optional)
OPENAI_API_KEY=

# Maps
GOOGLE_MAPS_API_KEY=

# CORS
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Event Processor
HTTP_PORT=8080

# --- Email / OTP delivery (SRS FR-AUTH-01) ---
# Email verification is enforced only when SMTP is configured, so leaving these
# blank keeps sign-up working in local development. Set them (and optionally
# REQUIRE_EMAIL_VERIFICATION=true) to enforce verified accounts.
# Port 465 speaks TLS from the first byte; 587 starts in the clear and
# upgrades with STARTTLS. Prefer 465 -- many consumer ISPs block 25 and 587
# outright as an anti-spam measure, and a STARTTLS-only client then just
# times out with no useful error. TLS style follows the port automatically;
# SMTP_USE_SSL_OVERRIDE only exists for providers on non-standard ports.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL_OVERRIDE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SafeHer
REQUIRE_EMAIL_VERIFICATION=

# --- Emergency evidence (FR-EMG-06/07) ---
# Recordings are stored on this backend, always encrypted with AES-256-GCM.
# Leave the key unset and one is derived from JWT_SECRET_KEY -- evidence is
# never written in the clear just because nobody configured this.
EVIDENCE_STORAGE_DIR=./evidence_store
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_MAX_SIZE_BYTES=26214400
