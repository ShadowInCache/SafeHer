# Core API
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=True
LOG_LEVEL=INFO

# Database
POSTGRES_USER=safeher
POSTGRES_PASSWORD=safeher
POSTGRES_DB=safeher
DATABASE_URL=postgresql://safeher:safeher@localhost:5432/safeher
# Read by deployment/docker/safeher_event_processor.py only, over plain
# REST. The FastAPI app has no Supabase settings and no client -- leave
# these blank unless you run the event processor's archive.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# JWT / Auth
JWT_SECRET_KEY=change-me
JWT_ISSUER=safeher
JWT_AUDIENCE=safeher-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Notifications
# Push. FCM v1 needs a SERVICE ACCOUNT JSON, not a server key: the legacy
# key API was decommissioned by Google and its endpoint now 404s.
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key, save the file outside version control, and point at it here.
# Keep the file OUTSIDE version control. ./secrets/ is gitignored.
# Local development: a path to the gitignored service account file.
FCM_SERVICE_ACCOUNT_FILE=
# Any deployed host: the same file's contents, raw JSON or base64.
# Set this instead of the path -- a deployed filesystem has no file to
# point at. Takes precedence when both are set.
FCM_SERVICE_ACCOUNT_JSON=./secrets/firebase-adminsdk.json
# Read by nothing; kept so an existing .env still loads.
FCM_SERVER_KEY=
# SMS. Costs money with every provider -- OneSignal is not an alternative
# here: its free-tier SMS works by connecting your own Twilio account, and
# its paid SMS is billed per message. Leave blank and SMS is reported as
# unconfigured rather than silently skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email, via OneSignal. Free tier covers 10,000 sends/month, but it needs a
# sending DOMAIN YOU OWN with SPF/DKIM/DMARC records -- Gmail and Outlook
# addresses are explicitly refused as senders. Use this once you have a
# domain; until then use the SMTP block above, which needs neither.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Storage (Cloudinary or Firebase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# If using Firebase Storage instead, set: FIREBASE_STORAGE_BUCKET=

# OpenAI (optional)
OPENAI_API_KEY=

# Maps
GOOGLE_MAPS_API_KEY=

# CORS
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Event Processor
HTTP_PORT=8080

# --- Email over HTTPS (Brevo) --- READ THIS BEFORE USING SMTP BELOW ---
# The channel that works on a host that blocks SMTP ports.
#
# Render's free web services block outbound 25, 465 and 587 -- every port SMTP
# speaks -- so the SMTP block below works on a laptop and silently fails in
# production. That took out emergency email AND emergency-contact
# verification, with nothing in the logs but timeouts.
#
# Brevo delivers over ordinary HTTPS on 443, which nothing blocks, and its
# free tier verifies an individual sender address (an ordinary Gmail account
# is fine) rather than demanding a domain you own -- which is what rules
# OneSignal out for this project. 300 emails/day, no card.
#
# Set this and email starts working; nothing else needs to change. The sender
# address is taken from SMTP_FROM_EMAIL below, so verify that same address in
# the Brevo dashboard under Senders.
#
# When set, this is preferred over SMTP. Leave it blank to use SMTP.
BREVO_API_KEY=

# --- Email / OTP delivery (SRS FR-AUTH-01) ---
# Email verification is enforced when *any* email channel is configured
# (Brevo or SMTP), so leaving both blank keeps sign-up working in local
# development. Set one (and optionally REQUIRE_EMAIL_VERIFICATION=true) to
# enforce verified accounts.
# Port 465 speaks TLS from the first byte; 587 starts in the clear and
# upgrades with STARTTLS. Prefer 465 -- many consumer ISPs block 25 and 587
# outright as an anti-spam measure, and a STARTTLS-only client then just
# times out with no useful error. TLS style follows the port automatically;
# SMTP_USE_SSL_OVERRIDE only exists for providers on non-standard ports.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL_OVERRIDE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SafeHer
# Seconds to wait on the SMTP socket. Ten, not twenty: the failure this
# usually meets is a blocked port, which hangs rather than refusing, and the
# emergency fan-out retries three times per channel per contact.
SMTP_TIMEOUT_SECONDS=10
REQUIRE_EMAIL_VERIFICATION=

# --- Emergency evidence (FR-EMG-06/07) ---
# Recordings are stored on this backend, always encrypted with AES-256-GCM.
# Leave the key unset and one is derived from JWT_SECRET_KEY -- evidence is
# never written in the clear just because nobody configured this.
EVIDENCE_STORAGE_DIR=./evidence_store
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_MAX_SIZE_BYTES=26214400

# --- AI incident summaries (FR-RPT-01) ---
# Gemini has a usable free tier, which is what makes this requirement
# reachable here at all. Unset, incidents simply have no summary -- the
# endpoint reports that rather than inventing one.
#
# Use the alias, not a pinned version: gemini-2.5-flash was retired for new
# keys mid-project and started answering 404.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Evidence object storage (Supabase) ---
# WHERE RECORDINGS ACTUALLY REST. Read this before deploying.
#
# Leaving these blank writes evidence to EVIDENCE_STORAGE_DIR -- a directory on
# the application server. On Render, and on most PaaS hosts, that filesystem is
# ephemeral: it is wiped on every deploy and every restart. Evidence of an
# assault gets encrypted correctly, stored carefully, and deleted by the next
# `git push`. Uploads still return 201 and the database row still persists, so
# nothing looks wrong until someone asks for the recording.
#
# Set these and evidence goes to Supabase Storage instead. The project already
# runs Supabase for the events archive, so this adds no new vendor and no bill.
#
# Setup: create a bucket named by EVIDENCE_BUCKET and keep it PRIVATE. The
# blobs are ciphertext -- EvidenceStore seals them with AES-256-GCM before any
# backend sees a byte -- so a public bucket would leak nothing readable, but a
# private one means an attacker needs the service key AND the encryption key.
#
# Use the SECRET (service_role) key, never the publishable one. The publishable
# key is meant to be handed to clients; a bucket its holder could read would put
# every recording one leaked mobile build away from disclosure.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# CASE-SENSITIVE. 'Evidence' and 'evidence' are different buckets in
# Supabase, and the wrong case fails with NoSuchBucket at the first upload.
EVIDENCE_BUCKET=Evidence
