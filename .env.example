# Core API
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=True
LOG_LEVEL=INFO

# Database / Supabase
POSTGRES_USER=safeher
POSTGRES_PASSWORD=safeher
POSTGRES_DB=safeher
DATABASE_URL=postgresql://safeher:safeher@localhost:5432/safeher
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# JWT / Auth
JWT_SECRET_KEY=change-me
JWT_ISSUER=safeher
JWT_AUDIENCE=safeher-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Notifications
FCM_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage (Cloudinary or Firebase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# If using Firebase Storage instead, set: FIREBASE_STORAGE_BUCKET=

# OpenAI (optional)
OPENAI_API_KEY=

# Maps
GOOGLE_MAPS_API_KEY=

# CORS
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Event Processor
HTTP_PORT=8080

# --- Email / OTP delivery (SRS FR-AUTH-01) ---
# Email verification is enforced only when SMTP is configured, so leaving these
# blank keeps sign-up working in local development. Set them (and optionally
# REQUIRE_EMAIL_VERIFICATION=true) to enforce verified accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SafeHer
REQUIRE_EMAIL_VERIFICATION=
