<?xml version="1.0" encoding="utf-8"?>
<!--
    Development only. Never included in a release build.

    Permits cleartext so `flutter run` can reach a backend on the LAN
    (http://192.168.x.x:5000). The release variant forbids it — see
    app/src/main/res/xml/network_security_config.xml.

    `user` trust anchors are included so a proxy like Charles or mitmproxy can
    inspect traffic while debugging. That is exactly the capability a release
    build must not have.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
